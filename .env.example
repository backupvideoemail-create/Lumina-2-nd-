# Server Configuration
PORT=3000
NODE_ENV=development
PUBLIC_APP_URL=https://ai-prime-studio.ai.studio
# Keep PROD_SERVER_URL pointing to the verified active backend URL (do not overwrite Android/legacy run.app without verification)
PROD_SERVER_URL=

# Gemini API Key (Server-side AI Generation)
GEMINI_API_KEY=

# Razorpay UPI AutoPay Credentials (Production / Staging)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Authentication Policy (Phone OTP disabled; Google Sign-In only)
PHONE_AUTH_ENABLED=false

# Higgsfield Developer API (Video Motion Transfer & Object Swap)
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# Cloudflare R2 Object Storage (Existing bucket: lumina-prime-ai-media)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lumina-prime-ai-media
R2_PUBLIC_BASE_URL=

# Firestore Database Lock (Leave unset or set strictly to (default); any other named DB value triggers CRITICAL_BLOCKED)
# FIRESTORE_DATABASE_ID=(default)

